# =========================================
# RiqFy — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# NUNCA commite o arquivo .env
# =========================================

PORT=8000
NODE_ENV=production

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_DE_48_BYTES

# Senha do painel admin master
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MASTER_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
MASTER_USER=admin

# MySQL — pegar credenciais no painel do provedor (ex: Hostinger hPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASSWORD=SUA_SENHA_MYSQL
DB_NAME=SEU_BANCO_MYSQL

# Origens permitidas (separadas por vírgula, sem espaço)
# Ex: ALLOWED_ORIGINS=https://meudominio.com,https://www.meudominio.com
ALLOWED_ORIGINS=https://SEU_DOMINIO.com

# Nível de log: error | warn | info (use 'warn' em produção)
LOG_LEVEL=warn

# =========================================
# SCRIPT SQL — Criar usuário MySQL dedicado
# Execute no MySQL como root:
#
#   CREATE USER 'riqfy_user'@'localhost' IDENTIFIED BY 'SENHA_FORTE';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX
#     ON riqfy.* TO 'riqfy_user'@'localhost';
#   FLUSH PRIVILEGES;
#
# Depois atualize DB_USER e DB_PASSWORD acima.
# =========================================
